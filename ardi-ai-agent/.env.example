TELEGRAM_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model fallback chain (primary first, comma-separated)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash
# Supabase PostgreSQL connection string
# Use Session pooler mode for IPv4 support
# Get yours from: Project Settings > Database > Connection string
# Select "Session pooler" tab, then copy and adjust:
# Replace: postgresql:// -> postgresql+asyncpg://
# URL-encode special chars in password (@ -> %40, # -> %23, etc.)
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Cloudflare R2 (free tier — 10GB storage)
# Create bucket: https://dash.cloudflare.com > R2 > Create Bucket
# Generate API token: R2 > Manage R2 API Tokens > Create API Token
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=ardi-products
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
# To get public URL: R2 Bucket > Settings > Public Access > Allow access

# Chapa (dashboard.chapa.co > API) — instant subscription checkout.
# Test keys start with CHASECK_TEST-, live keys with CHASECK-.
CHAPA_SECRET_KEY=

# Admin web dashboard (required — fail-closed if empty)
ADMIN_API_KEY=change-me-to-a-long-random-string
ADMIN_TELEGRAM_ID=123456789

# Telegram Mini App: BARE service URL (no trailing path — bot appends /business itself)
# e.g. MINI_APP_URL=https://ardi.onrender.com
MINI_APP_URL=https://your-miniapp-url

# Error monitoring (optional)
SENTRY_DSN=

# Rate limiting (optional)
RATE_LIMIT_CALLS=30
RATE_LIMIT_WINDOW=60
